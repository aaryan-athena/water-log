# Optional settings. Set them in Vercel -> Project -> Settings -> Environment
# Variables, or export them locally. None are required, and none are secrets.

# Minimum confidence for a region to count as standing water (0-1).
WATERLOG_CONF=0.25
# Overlap threshold for merging duplicate regions (0-1).
WATERLOG_IOU=0.45
# Coverage % at or above which a result is flagged as an alert.
WATERLOG_ALERT_COVERAGE_PCT=8.0
# Largest upload accepted, in MB (the browser downscales before upload).
WATERLOG_MAX_UPLOAD_MB=8
# Longest image side processed; larger images are downscaled first.
WATERLOG_MAX_SIDE=1600
